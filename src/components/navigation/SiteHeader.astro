---
import FeaturedNavigation from '@components/navigation/FeaturedNavigation.astro';
import MainNavigation from '@components/navigation/MainNavigation.astro';
import MobileNavigation from '@components/navigation/MobileNavigation.astro';
import { getEntry } from 'astro:content';

interface Props {
    style?: 'default' | 'transparent';
}

const { style = 'default' } = Astro.props;

// get main nav by id
const mainNavigation = await getEntry(
    'navigation',
    'b2b3beb7-b8b4-44bb-9e5d-45c46f45a0b9',
);
const featuredNavigation = await getEntry(
    'navigation',
    '61ff2539-4de8-49d0-8c3d-0591314b1d21',
);
---

<header class="site-header" data-style={style}>
    <!-- Skip to Content Link -->
    <a class="skip-link | small-title text-step--1" href="#main-content">
        Skip to Content
    </a>
    <MainNavigation navItems={mainNavigation?.data.items} />
    <nav aria-label="Featured" class="nav-featured">
        <div class="logos | cluster">
            <a class="logo-link" href="/">
                <img
                    alt="UCLA Pourdavoud Institute logo"
                    decoding="auto"
                    loading="eager"
                    src={style === 'transparent'
                        ? '/images/logos/pourdavoud-logo-UCLA-white.svg'
                        : '/images/logos/pourdavoud-logo-UCLA.svg'}
                    width="325"
                />
            </a>
        </div>
        <FeaturedNavigation
            navItems={featuredNavigation?.data.items}
            style={style}
        />
        <MobileNavigation
            featuredNavItems={featuredNavigation?.data.items}
            mainNavItems={mainNavigation?.data.items}
            style={style}
        />
    </nav>
</header>

<style>
    .site-header {
        position: relative;
        /* box-shadow: var(--shadow-base); */
        z-index: 50;
        background-color: var(--ucla-white);

        &.home {
            position: absolute;
            width: 100%;
            background-color: var(--ucla-white);
        }

        &[data-style='transparent'] {
            position: absolute;
            width: 100%;
            background-color: transparent;
        }
    }

    .nav-featured {
        position: relative;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        padding-inline: 2rem;

        & > :last-child {
            flex-grow: 1;
        }
    }

    .logos {
        padding-block: 1rem;

        & img {
            width: 30rem;
        }
    }

    .logo-link {
        &:hover {
            opacity: 0.75;
        }
    }

    @media screen and (max-width: 640px) {
        .logos {
            & img {
                max-width: 20rem;
            }
        }

        .nav-featured {
            padding-inline: 1rem;
        }
    }

    @media screen and (max-width: 450px) {
        .logos {
            & img {
                max-width: 15rem;
            }
        }
    }

    @media screen and (max-width: 350px) {
        .logos {
            & img {
                max-width: 12rem;
            }
        }
    }
</style>
