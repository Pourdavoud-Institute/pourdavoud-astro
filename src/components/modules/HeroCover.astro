---
import type { HeroCover } from '@content/schemaFragments/pageModules';
import RichTextBlocksLite from '@components/richText/RichTextBlocksLite.astro';
import SanityImage from '@components/SanityImage.astro';
import { sanityLink } from '@lib/utils/sanityLink';
import { getEntry } from 'astro:content';

interface Props {
    module: HeroCover;
}

const { module } = Astro.props;
---

<div data-module={module._type}>
    <header>
        <div class="content-wrapper">
            <div class="text-wrapper">
                <p class="small-title eyebrow">UCLA Pourdavoud Institute</p>
                <h1 class="mega-title boxed">{module.heading}</h1>
                <!-- <div class="scroll-link">
                    <a
                        class="button-link"
                        data-style="white"
                        href={module.cta[0]?.href}
                    >
                        <span class="small-title">{module.cta[0]?.label}</span>
                    </a>
                </div> -->
            </div>
            {
                module.footerList.length > 0 && (
                    <footer class="hero-footer">
                        {module.footerList.map(async (footerItem) => {
                            if (
                                footerItem._type === 'footerListItem' &&
                                footerItem.link
                            ) {
                                const link = sanityLink(footerItem.link);
                                return (
                                    <article class="hero-footer-item">
                                        <a
                                            class="flow | item-wrapper"
                                            data-tempo="vivace"
                                            href={link.url}
                                        >
                                            <p class="heading">
                                                {footerItem.heading}
                                            </p>
                                            <div class="summary">
                                                <RichTextBlocksLite
                                                    blocks={footerItem.summary}
                                                />
                                            </div>
                                        </a>
                                    </article>
                                );
                            } else if (footerItem._type === 'footerListItem') {
                                <article class="hero-footer-item">
                                    <div
                                        class="item-wrapper flow"
                                        data-tempo="vivace"
                                    >
                                        <p class="heading">
                                            {footerItem.heading}
                                        </p>
                                        <div class="summary">
                                            <RichTextBlocksLite
                                                blocks={footerItem.summary}
                                            />
                                        </div>
                                    </div>
                                </article>;
                            } else if (footerItem._type === 'event') {
                                const reference = await getEntry(
                                    'events',
                                    footerItem._id,
                                );
                                if (reference) {
                                    return (
                                        <article class="hero-footer-item">
                                            <a
                                                class="flow | item-wrapper"
                                                data-tempo="vivace"
                                                href={`/events/${reference.data.slug}`}
                                            >
                                                <p class="heading">
                                                    {reference.data.title}
                                                </p>
                                                {reference.data.preview && (
                                                    <div class="summary">
                                                        <RichTextBlocksLite
                                                            blocks={
                                                                reference.data
                                                                    .preview
                                                            }
                                                        />
                                                    </div>
                                                )}
                                            </a>
                                        </article>
                                    );
                                }
                            } else if (footerItem._type === 'post') {
                                const reference = await getEntry(
                                    'posts',
                                    footerItem._id,
                                );
                                if (reference) {
                                    return (
                                        <article class="hero-footer-item">
                                            <a
                                                class="flow | item-wrapper"
                                                data-tempo="vivace"
                                                href={`/posts/${reference.data.slug}`}
                                            >
                                                <p class="heading">
                                                    {reference.data.title}
                                                </p>
                                                {reference.data.preview && (
                                                    <div class="summary">
                                                        <RichTextBlocksLite
                                                            blocks={
                                                                reference.data
                                                                    .preview
                                                            }
                                                        />
                                                    </div>
                                                )}
                                            </a>
                                        </article>
                                    );
                                }
                            }
                        })}
                    </footer>
                )
            }
        </div>
    </header>
    <div class="overlay"></div>
    <SanityImage
        alt={module.image.alt}
        aspectRatio={[16, 9]}
        classes="cover-image"
        loading="eager"
        quality={70}
        source={module.image}
        width={1600}
    />
</div>

<style>
    [data-module='heroCover'] {
        position: relative;
        background-color: var(--ucla-primary-blue);

        & header {
            position: relative;
            overflow-y: hidden;
        }
    }

    .eyebrow {
        color: white;
        font-size: var(--step--1);
        margin-block-end: var(--space-2xs);
    }

    .content-wrapper {
        /* height: 100dvh; */
        /* display: flex; */
        /* flex-direction: column; */
        /* gap: 1rem; */
        /* align-items: center; */
        /* justify-content: center; */
        z-index: 2;
        /* padding-block-start: calc(var(--space-l) + var(--header-height)); */
        padding-block-end: var(--space-l);
    }

    .text-wrapper {
        margin-block-start: 22rem;
        max-width: 60%;
        /* text-align: center; */
    }

    .yarshater-seal {
        fill: var(--ucla-white);
        width: 10rem;
    }

    .scroll-link {
        position: relative;

        &::after {
            content: '';
            position: absolute;
            top: 7rem;
            left: 50%;
            transform: translateX(-50%);
            width: 1px;
            height: 200px;
            background-color: var(--ucla-white);
            opacity: 0.45;
        }

        & a {
            padding: 0.75rem 1.25rem;
            margin-block-start: var(--space-m);
            margin-inline: auto;

            &:hover {
                & svg {
                    transform: scale(1.3);
                }
            }
        }

        & svg {
            width: 2rem;
            height: 2rem;
            fill: var(--ucla-white);
            transition: transform 0.3s;
        }
    }

    .cover-image {
        position: absolute;
        z-index: 0;
        top: 0;
        object-fit: cover;
        width: 100%;
        height: 100%;
        /* opacity: 0.65; */
        /* filter: grayscale(1); */
        /* mix-blend-mode: multiply; */
    }

    .overlay {
        position: absolute;
        inset: 0;
        z-index: 1;
        width: 100%;
        height: 100%;
        background: linear-gradient(to top, rgb(0 0 0 / 90%), rgb(0 0 0 / 30%));
    }

    .hero-footer {
        position: relative;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: var(--space-m);
        align-items: stretch;
        margin-block-start: var(--space-2xl);

        & > *:not(:first-child) {
            &::before {
                content: '';
                position: absolute;
                bottom: calc(var(--space-l) * -1);
                left: calc(var(--space-m) / -2);
                height: calc(100% + var(--space-l));
                width: 1px;
                background-color: white;
                opacity: var(--hero-footer-item-rule, 0.3);
            }
        }
    }

    .hero-footer-item {
        position: relative;
        color: white;

        & .heading {
            font-family: var(--font-heading);
            font-weight: var(--font-heading-weight);
            font-size: var(--step-2);
            line-height: var(--leading-tight);
            text-decoration: underline transparent;
        }

        & .item-wrapper {
            padding: 0.5rem 1rem 1rem 1rem;
        }

        & a {
            display: block;
            height: 100%;
            text-decoration: none;
            transition: background 0.3s;

            &:hover {
                /* background-color: rgba(0 46 72 / 50%); */
                background-color: rgb(0 0 0 / 50%);

                & .heading {
                    text-decoration-color: white;
                }
            }
        }
    }

    @media screen and (max-width: 1024px) {
        [data-module='heroCover'] {
            & .text-wrapper {
                max-width: none;
            }
        }
    }

    @media screen and (max-width: 850px) {
        .hero-footer {
            --hero-footer-item-rule: 0;
            grid-template-columns: 1fr;
        }
    }

    @media screen and (max-width: 768px) {
        .text-wrapper {
            margin-block-start: 14rem;
        }

        .hero-footer {
            gap: var(--space-s);
        }

        .hero-footer-item {
            & a {
                background-color: rgb(0 0 0 / 20%);
            }
        }
    }

    @media screen and (max-width: 450px) {
        [data-module='heroCover'] {
            & h1.boxed {
                padding-inline: var(--space-xs);
                line-height: 1.35;
            }
        }
    }
</style>
